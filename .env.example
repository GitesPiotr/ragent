# ==========================================================
# Przyklad konfiguracji. Skopiuj ten plik jako .env.local
# i uzupelnij wartosci. NIE commituj .env.local do repo.
# ==========================================================

# --- Supabase (baza danych) ---
# Znajdziesz w panelu Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (Claude - silnik agenta i mentora) ---
# Klucz z console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# --- Tavily (wyszukiwarka web dla narzedzia web_search) ---
# Klucz z app.tavily.com
TAVILY_API_KEY=

# --- Logowanie deweloperskie (TYLKO lokalnie, opcjonalne) ---
# Wlacza przycisk "Zaloguj jako deweloper" na ekranie logowania.
# To NIE jest obejscie logowania — przycisk loguje przez zwykly mechanizm
# Supabase, tymi danymi. Konto musi najpierw istniec w Supabase
# (Authentication > Users albo przez ekran rejestracji).
# Bez prefiksu NEXT_PUBLIC_, wiec wartosci nigdy nie trafiaja do przegladarki.
# Na produkcji przycisk i endpoint sa wylaczone niezaleznie od tych zmiennych.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=

# --- Opcjonalne (maja wartosci domyslne, mozesz pominac) ---
# Model uzywany przez mentora (domyslnie: claude-haiku-4-5)
MENTOR_MODEL=
# Adres lokalnego serwera Ollama (domyslnie: http://localhost:11434)
OLLAMA_BASE_URL=

# ==========================================================
# --- MODUL RAG ---
# Wszystkie ponizsze poza RAG_SUPABASE_SERVICE_KEY sa OPCJONALNE:
# puste = wartosc domyslna z lib/rag/config.js (jedyny plik w module,
# ktory czyta process.env — tam sa opisy i uzasadnienia wartosci).
# ==========================================================

# Wymagane. Klucz service_role z Supabase (Project Settings > API).
# Omija RLS — nigdy nie umieszczaj go po stronie przegladarki.
RAG_SUPABASE_SERVICE_KEY=
# Puste => uzyty zostanie NEXT_PUBLIC_SUPABASE_URL.
RAG_SUPABASE_URL=
RAG_TABLE_PREFIX=

# Embeddingi
RAG_EMBED_PROVIDER=
RAG_EMBED_MODEL=
RAG_EMBED_DIM=
RAG_EMBED_BATCH=
RAG_EMBED_DOC_PREFIX=
RAG_EMBED_QUERY_PREFIX=
RAG_OLLAMA_URL=

# Pliki
RAG_MAX_FILE_MB=

# Podzial na fragmenty
RAG_CHUNK_SIZE=
RAG_CHUNK_MAX=
RAG_CHUNK_MIN=
RAG_CHUNK_OVERLAP=
RAG_PREPEND_HEADINGS=

# Mapa fragmentow
RAG_PROJECTION_MIN_CHUNKS=
RAG_MAP_NEIGHBORS=

# Wyszukiwanie
RAG_TOP_K=
RAG_MIN_SCORE=
RAG_DEDUP=
RAG_SEARCH_LOG=

# Wydobywanie pojec
RAG_CONCEPT_PROVIDER=
RAG_CONCEPT_MODEL=
RAG_CONCEPT_PER_CHUNK=
RAG_CONCEPT_BATCH=
RAG_CONCEPT_MIN_WORDS=
RAG_CONCEPT_MERGE_THRESHOLD=
RAG_CONCEPT_MERGE_LEXICAL=
RAG_CONCEPT_MERGE_LEXICAL_MIN=
RAG_CONCEPT_STEM_MIN=
